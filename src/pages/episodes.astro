---
import Layout from '../layouts/Layout.astro';
import { episodes } from '../data/episodes';

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Layout title="Episodes - Tool Use Podcast" description="Browse all episodes of the Tool Use Podcast. AI tools that actually work.">
  <main class="min-h-screen px-6 py-12 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="mb-12">
      <a href="/" class="text-neutral-500 hover:text-orange-400 transition-colors text-sm mb-6 inline-block">&larr; Home</a>
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-3">
        <span class="text-orange-500">All</span> Episodes
      </h1>
      <p class="text-neutral-400 text-lg">{episodes.length} episodes and counting.</p>
    </div>

    <!-- Episode List -->
    <div class="space-y-1">
      {episodes.map((ep) => (
        <div class="group border-b border-neutral-800/50 py-5 transition-colors">
          <div class="flex items-start gap-4">
            <span class="text-neutral-600 font-mono text-sm pt-1 w-8 shrink-0 text-right">
              {ep.number}
            </span>
            <div class="flex-1 min-w-0">
              <h2 class="text-white font-semibold text-lg leading-snug mb-1 group-hover:text-orange-400 transition-colors">
                {ep.title}
              </h2>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm mb-2">
                {ep.guest && (
                  <span class="text-orange-400/80">{ep.guest}</span>
                )}
                {ep.date && (
                  <span class="text-neutral-600">{formatDate(ep.date)}</span>
                )}
              </div>
              <p class="text-neutral-500 text-sm leading-relaxed">{ep.description}</p>
              <div class="flex gap-3 mt-3">
                {ep.youtubeUrl && (
                  <a
                    href={ep.youtubeUrl}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 text-xs text-neutral-500 hover:text-orange-400 transition-colors"
                  >
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                    YouTube
                  </a>
                )}
                {ep.spotifyUrl && (
                  <a
                    href={ep.spotifyUrl}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 text-xs text-neutral-500 hover:text-orange-400 transition-colors"
                  >
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                    Spotify
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Footer -->
    <div class="mt-16 text-center text-neutral-600 text-sm">
      <p>New episodes every Tuesday.</p>
    </div>
  </main>

  <!-- Subtle gradient glow -->
  <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-orange-500/5 rounded-full blur-[120px]"></div>
  </div>
</Layout>
