---
import Layout from '../layouts/Layout.astro';
import { episodes } from '../data/episodes';

function formatDate(dateStr: string | null): string {
  if (!dateStr) return '';
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<Layout title="Episodes — Tool Use Podcast" description="Browse all episodes of the Tool Use Podcast. Great Tools Build Good AI.">
  <section class="bg-brand-grey text-black px-8 py-20 min-h-screen">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-14">
        <h1 class="font-display uppercase leading-[0.86] text-[clamp(56px,8vw,120px)] mb-4">
          All <span class="text-brand-blue">Episodes</span>
        </h1>
        <p class="font-extended font-medium text-lg">{episodes.length} episodes and counting.</p>
      </div>

      <!-- Episode List -->
      <div>
        {episodes.map((ep) => (
          <article class="group border-b border-black/10 py-6">
            <div class="flex items-start gap-5">
              <span class="font-display uppercase text-2xl text-black bg-white px-3 pt-0.5 pb-1 rounded-lg shrink-0 mt-0.5">
                {ep.number}
              </span>
              <div class="flex-1 min-w-0">
                <h2 class="font-extended font-bold text-xl leading-snug mb-1.5 group-hover:text-brand-blue transition-colors">
                  {ep.title}
                </h2>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm mb-2">
                  {ep.guest && (
                    <span class="font-extended font-bold text-xs uppercase tracking-wider text-brand-blue">{ep.guest}</span>
                  )}
                  {ep.date && (
                    <span class="text-neutral-600">{formatDate(ep.date)}</span>
                  )}
                </div>
                <p class="text-neutral-700 text-sm leading-relaxed">{ep.description}</p>
                <div class="flex gap-5 mt-3 font-extended font-bold text-xs uppercase tracking-wider">
                  {ep.youtubeUrl && (
                    <a href={ep.youtubeUrl} target="_blank" rel="noopener" class="border-b-2 border-brand-orange pb-0.5 hover:text-brand-orange transition-colors">
                      YouTube
                    </a>
                  )}
                  {ep.spotifyUrl && (
                    <a href={ep.spotifyUrl} target="_blank" rel="noopener" class="border-b-2 border-brand-orange pb-0.5 hover:text-brand-orange transition-colors">
                      Spotify
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="font-extended font-medium text-sm uppercase tracking-wider text-neutral-600 mt-14">
        New episodes every Tuesday.
      </p>
    </div>
  </section>
</Layout>
