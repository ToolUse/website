---
import Layout from '../layouts/Layout.astro';
import { episodes } from '../data/episodes';

const latest = episodes.slice(0, 3);
---

<Layout title="Tool Use Podcast — Great Tools Build Good AI">
  <!-- Hero -->
  <header class="bg-brand-orange text-black px-8 pt-16 overflow-hidden">
    <div class="max-w-6xl mx-auto grid grid-cols-[1.4fr_1fr] max-md:grid-cols-1 gap-10 items-end">
      <div>
        <h1 class="font-display uppercase leading-[0.86] text-[clamp(72px,11vw,168px)] mb-8">
          Great<br />Tools<br />
          <span class="text-brand-blue">Build</span><br />
          <span class="text-brand-grey">Good</span> AI
        </h1>
        <p class="font-extended font-medium text-[clamp(17px,1.6vw,22px)] max-w-md mb-9">
          The podcast for builders who refuse to be passengers.
          Real tools, real deployments, real workflows — hosted by Mike Bird.
        </p>
        <div class="flex gap-4 flex-wrap mb-16">
          <a
            href="https://www.youtube.com/@ToolUsePodcast"
            target="_blank"
            rel="noopener"
            class="font-extended font-bold uppercase tracking-wider text-sm bg-black hover:bg-brand-blue text-white px-8 py-3.5 rounded-full transition-all hover:-translate-y-0.5"
          >Watch on YouTube</a>
          <a
            href="https://open.spotify.com/show/4mYqyL7gGglZV7ByW8TVe9"
            target="_blank"
            rel="noopener"
            class="font-extended font-bold uppercase tracking-wider text-sm border-2 border-black text-black hover:bg-black hover:text-white px-8 py-3.5 rounded-full transition-all hover:-translate-y-0.5"
          >Listen on Spotify</a>
        </div>
      </div>
      <img class="w-full max-w-md justify-self-end self-center pb-16 max-md:justify-self-start max-md:max-w-64 max-md:pb-10" src="/assets/T-U_Full_Blue.svg" alt="" />
    </div>
  </header>

  <!-- Manifesto — hidden for now; Mike will write the final copy himself.
  <section class="bg-black px-8 py-28">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-display uppercase leading-[0.86] text-[clamp(48px,6.5vw,104px)] text-white">
        The era of <span class="text-brand-orange">passive observation</span> is over
      </h2>
      <div class="h-8"></div>
      <p class="text-brand-grey text-[17px] leading-relaxed mb-5">
        Unmonitored algorithms are taking over the stack while most people
        watch from the sidelines. <strong class="text-white font-semibold">Not on our watch.</strong>
      </p>
      <p class="text-brand-grey text-[17px] leading-relaxed">
        Tool Use is a high-trust laboratory: deep knowledge and advanced
        tools, combined into systems that are beautiful, safe, and
        human-driven. <strong class="text-white font-semibold">Builders remain in charge</strong> —
        from architecture to execution.
      </p>
    </div>
  </section>
  -->

  <!-- Latest episodes -->
  <section class="bg-brand-grey text-black px-8 pt-24 pb-28">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between flex-wrap gap-6 mb-14">
        <h2 class="font-display uppercase leading-[0.86] text-[clamp(56px,8vw,128px)]">
          Latest <span class="text-brand-blue">Drops</span>
        </h2>
        <a href="/episodes" class="font-extended font-bold uppercase text-sm tracking-wider border-b-[3px] border-brand-blue pb-1.5 hover:text-brand-blue transition-colors">
          Browse all {episodes.length} episodes &rarr;
        </a>
      </div>

      <div class="grid grid-cols-3 max-lg:grid-cols-1 gap-7">
        {latest.map((ep) => (
          <article class="bg-white rounded-2xl overflow-hidden flex flex-col transition-transform hover:-translate-y-1.5">
            <a href={ep.youtubeUrl ?? '/episodes'} target="_blank" rel="noopener" class="block relative aspect-[16/9.1] bg-[url('/assets/swoosh-card.png')] bg-cover bg-center">
              <span class="absolute top-4 left-5 font-display uppercase text-3xl text-black bg-white px-3.5 pt-0.5 pb-1.5 rounded-lg">
                Episode {ep.number}
              </span>
              <span class="absolute right-4 bottom-4 w-13 h-13 rounded-full bg-brand-blue grid place-items-center">
                <svg class="w-4.5 h-4.5 fill-white ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </span>
            </a>
            <div class="p-6 pb-7 flex flex-col gap-3 flex-1">
              {ep.guest && (
                <p class="font-extended font-bold text-xs uppercase tracking-wider text-brand-blue">{ep.guest}</p>
              )}
              <h3 class="font-display uppercase text-3xl leading-[0.95] text-black">{ep.title}</h3>
              <p class="text-sm leading-relaxed text-neutral-800 flex-1">{ep.description}</p>
              <div class="flex gap-5 font-extended font-bold text-xs uppercase tracking-wider">
                {ep.youtubeUrl && (
                  <a href={ep.youtubeUrl} target="_blank" rel="noopener" class="border-b-2 border-brand-orange pb-0.5 hover:text-brand-orange transition-colors">YouTube</a>
                )}
                {ep.spotifyUrl && (
                  <a href={ep.spotifyUrl} target="_blank" rel="noopener" class="border-b-2 border-brand-orange pb-0.5 hover:text-brand-orange transition-colors">Spotify</a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
